# Mode B: scanner posts RSSI scans directly to the positioning engine.
# Config lives in /etc/positioning-scanner.env — retarget by editing that file
# and running `sudo systemctl restart scanner` (no code change, no live endpoint).

[Unit]
Description=WiFi Scanner for Indoor Positioning (engine ingestion)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi
# unbuffered stdout so journal logs appear in real time
Environment=PYTHONUNBUFFERED=1
# '-' prefix: start with built-in defaults even if the env file is absent
EnvironmentFile=-/etc/positioning-scanner.env
ExecStart=/usr/bin/python3 -u /home/pi/scanner.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
