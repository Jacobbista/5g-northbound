# Copy to .env and fill in. The .env file is gitignored.
# Used by deploy.sh; values are pushed to /etc/positioning-scanner.env on the Pi.

# SSH target — required
PI_HOST=pi@CHANGE-ME

# Adapter the scanner posts scans to — required
# Test:       http://<your-dev-host>:8089
# Production: http://wifi-positioning.<namespace>.svc.cluster.local:8080
ADAPTER_URL=http://CHANGE-ME:8089

# Stable identifier of the positioned asset. MUST match the gateway's
# DEVICE_REGISTRY value for this device's CAMARA identifier.
DEVICE_ID=wifi-asset-01

INTERFACE=wlan0
SEND_INTERVAL=1.0
