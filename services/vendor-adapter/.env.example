# Copy to .env (gitignored) and fill in. Then either:
#   - export the vars in the shell before `make demo`, or
#   - reference this file from docker-compose with `env_file: ./vendor-adapter/.env`.
#
# Schema-driven: the variable NAMES come from the active schema at
# /app/data/schema.json. The defaults below match wittra-schema.json
# (shipped in vendor-adapter/examples/). Replace each value with whatever
# the operator received from the vendor account.

# --- Wittra UWB cloud --------------------------------------------------------

# Override of the default base URL declared in the schema. Set to
# https://api.wittra.se for the real cloud, or to http://mock-vendor:8080
# when running against the local demo fake.
WITTRA_BASE_URL=https://api.wittra.se

# Identifies your Wittra organization inside the API path AND doubles as the
# HTTP basic-auth username.
WITTRA_ORG_ID=CHANGE-ME

# Project under that organization. Path variable only; not used in auth.
WITTRA_PROJECT_ID=CHANGE-ME

# HTTP basic-auth password. SENSITIVE; keep this file local, never commit.
WITTRA_API_KEY=CHANGE-ME
