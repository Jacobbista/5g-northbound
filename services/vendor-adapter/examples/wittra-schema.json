{
  "vendor": "wittra",
  "transport": "rest",
  "baseUrl": {
    "env": "WITTRA_BASE_URL"
  },
  "path": "/v4/organizations/{org_id}/projects/{project_id}/devices/{device_id}",
  "pathVars": {
    "org_id": {
      "env": "WITTRA_ORG_ID"
    },
    "project_id": {
      "env": "WITTRA_PROJECT_ID"
    }
  },
  "auth": {
    "scheme": "basic",
    "username": {
      "env": "WITTRA_ORG_ID"
    },
    "password": {
      "env": "WITTRA_API_KEY"
    }
  },
  "cacheTtl": 5.0,
  "requestTimeout": 5.0,
  "mapping": {
    "frame": {
      "const": "wgs84"
    },
    "latitude": {
      "path": "latest.data.location.value.latitude"
    },
    "longitude": {
      "path": "latest.data.location.value.longitude"
    },
    "accuracy": {
      "path": "latest.data.location.value.accuracy",
      "default": 5.0
    },
    "confidence": {
      "const": 0.5
    },
    "y": {
      "path": "latest.data.location.value.height",
      "default": 0.0
    },
    "timestamp": {
      "path": "latest.data.location.timestamp",
      "format": "iso8601"
    },
    "lastSeen": {
      "path": "lastSeen",
      "format": "iso8601"
    }
  },
  "discover": {
    "path": "/v4/organizations/{org_id}/projects/{project_id}/devices",
    "listPath": "",
    "pathVars": {
      "org_id": {
        "env": "WITTRA_ORG_ID"
      },
      "project_id": {
        "env": "WITTRA_PROJECT_ID"
      }
    },
    "pagination": {
      "type": "none"
    },
    "mapping": {
      "vendorDeviceId": {
        "path": "deviceId"
      },
      "label": {
        "path": "name",
        "default": null
      },
      "latitude": {
        "path": "fixedLocation.latitude"
      },
      "longitude": {
        "path": "fixedLocation.longitude"
      },
      "height": {
        "path": "fixedLocation.height",
        "default": 0
      },
      "deviceType": {
        "path": "deviceType"
      }
    },
    "filter": {
      "requirePath": "fixedLocation.latitude"
    },
    "classify": {
      "assetWhen": {
        "path": "deviceType",
        "equals": "tag"
      }
    }
  },
  "diagnostics": {
    "stream": {
      "motion": {
        "path": "latest.data.location.value.motion"
      }
    },
    "onDemand": [
      {
        "path": "/v4/organizations/{org_id}/projects/{project_id}/devices/{device_id}",
        "pathVars": {
          "org_id": {
            "env": "WITTRA_ORG_ID"
          },
          "project_id": {
            "env": "WITTRA_PROJECT_ID"
          }
        },
        "mapping": {
          "battery": {
            "path": "latest.data.battery.percentage"
          },
          "motion": {
            "path": "latest.data.location.value.motion"
          },
          "accuracy_value": {
            "path": "latest.data.location.value.accuracy"
          },
          "accuracy_kind": {
            "const": "vendor-radius"
          },
          "lastSeen": {
            "path": "latest.data.location.timestamp",
            "format": "iso8601"
          }
        }
      }
    ]
  }
}
