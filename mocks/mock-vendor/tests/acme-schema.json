{
  "vendor": "acme",
  "transport": "rest",
  "baseUrl": {
    "env": "ACME_BASE_URL"
  },
  "path": "/api/{tenant}/device/{device_id}/pos",
  "pathVars": {
    "tenant": {
      "env": "ACME_TENANT"
    }
  },
  "auth": {
    "scheme": "bearer",
    "token": {
      "env": "ACME_TOKEN"
    }
  },
  "mapping": {
    "frame": {
      "const": "wgs84"
    },
    "latitude": {
      "path": "data.lat"
    },
    "longitude": {
      "path": "data.lng"
    },
    "accuracy": {
      "path": "data.acc",
      "default": 5.0
    },
    "confidence": {
      "const": 0.5
    },
    "y": {
      "path": "data.alt",
      "default": 0.0
    },
    "timestamp": {
      "path": "data.ts",
      "format": "iso8601"
    }
  },
  "discover": {
    "path": "/api/{tenant}/devices",
    "listPath": "items",
    "pathVars": {
      "tenant": {
        "env": "ACME_TENANT"
      }
    },
    "mapping": {
      "vendorDeviceId": {
        "path": "id"
      },
      "label": {
        "path": "name"
      },
      "latitude": {
        "path": "anchor.lat"
      },
      "longitude": {
        "path": "anchor.lng"
      },
      "height": {
        "path": "anchor.h"
      },
      "deviceType": {
        "path": "kind"
      }
    },
    "classify": {
      "assetWhen": {
        "path": "kind",
        "equals": "mobile"
      }
    }
  },
  "diagnostics": {
    "stream": {
      "motion": {
        "path": "data.motion"
      }
    },
    "onDemand": [
      {
        "path": "/api/{tenant}/device/{device_id}/uwb",
        "pathVars": {
          "tenant": {
            "env": "ACME_TENANT"
          }
        },
        "mapping": {
          "rssi": {
            "path": "uwb.rssi"
          },
          "accuracy_kind": {
            "const": "vendor-radius"
          }
        }
      }
    ]
  }
}
